@page "/staff/tickets"
@attribute [Authorize(Roles = "Staff,Admin")]
@rendermode InteractiveServer
@inject ITicketAndChatService TicketService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Tickets CSKH</PageTitle>
<h1 class="h3 mb-3">Trung tâm xử lý yêu cầu & khiếu nại</h1>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageClass">@message</div>
}

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-sm @(filter is null ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetFilter(null)">Tất cả</button>
    <button class="btn btn-sm @(filter == TicketStatus.Open ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetFilter(TicketStatus.Open)">Mới</button>
    <button class="btn btn-sm @(filter == TicketStatus.InProgress ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetFilter(TicketStatus.InProgress)">Đang xử lý</button>
    <button class="btn btn-sm @(filter == TicketStatus.Resolved ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetFilter(TicketStatus.Resolved)">Đã phản hồi</button>
</div>

<div class="row g-3">
    @foreach (var ticket in tickets)
    {
        <div class="col-lg-6">
            <div class="border rounded p-3 h-100">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="fw-semibold">@ticket.Subject</div>
                        <div class="small text-muted">@ticket.CustomerEmail - @ticket.Type - @ticket.Status</div>
                    </div>
                    <span class="badge text-bg-light">#@ticket.Id</span>
                </div>
                <p class="mt-3">@ticket.Description</p>
                @if (!string.IsNullOrWhiteSpace(ticket.EvidenceUrl))
                {
                    <a href="@ticket.EvidenceUrl" target="_blank" class="btn btn-sm btn-outline-secondary mb-3">Xem minh chứng</a>
                }
                <EditForm Model="responseInputs[ticket.Id]" OnValidSubmit="() => ResolveAsync(ticket.Id)">
                    <DataAnnotationsValidator />
                    <InputTextArea class="form-control" rows="3" @bind-Value="responseInputs[ticket.Id].Response" placeholder="Nhập phản hồi gửi khách hàng" />
                    <ValidationMessage For="@(() => responseInputs[ticket.Id].Response)" />
                    <button class="btn btn-primary btn-sm mt-2">Gửi phản hồi</button>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private TicketStatus? filter;
    private List<SupportTicket> tickets = [];
    private readonly Dictionary<long, TicketResponseInput> responseInputs = [];
    private string? message;
    private string messageClass = "alert-success";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SetFilter(TicketStatus? status)
    {
        filter = status;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        tickets = await TicketService.GetTicketsAsync(filter);
        foreach (var ticket in tickets)
        {
            responseInputs.TryAdd(ticket.Id, new TicketResponseInput { TicketId = ticket.Id });
        }
    }

    private async Task ResolveAsync(long ticketId)
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            await TicketService.ResolveTicketAsync(responseInputs[ticketId], auth.User.Identity?.Name ?? "staff");
            await LoadAsync();
            ShowSuccess("Đã gửi phản hồi và tạo notification/email cho khách hàng.");
        }
        catch (Exception ex) { ShowError(ex.Message); }
    }

    private void ShowSuccess(string text) { messageClass = "alert-success"; message = text; }
    private void ShowError(string text) { messageClass = "alert-danger"; message = text; }
}
